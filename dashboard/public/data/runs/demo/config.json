{
  "data_dir": "data_to_train_on_clean",
  "random_state": 42,
  "test_size": 0.2,
  "val_size": 0.1,
  "split_mode": "random",
  "model_name": "microsoft/codebert-base",
  "max_length": 384,
  "categorical_emb_dim": 16,
  "hidden_dim": 128,
  "dropout": 0.2,
  "freeze_encoder": false,
  "use_lora": true,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "query",
    "value"
  ],
  "ffa_lora": true,
  "warmstart_project": "lsstcorp",
  "warmstart_val_size": 0.15,
  "warmstart_epochs": 10,
  "warmstart_patience": 3,
  "warmstart_lr": 0.00003,
  "skip_centralized": false,
  "skip_local_only": false,
  "run_no_warmstart_fl": true,
  "batch_size": 8,
  "local_epochs": 1,
  "rounds": 20,
  "clients_per_round_fraction": 1,
  "local_sample_ratio_per_epoch": 1,
  "sample_with_replacement": false,
  "learning_rate": 0.00003,
  "weight_decay": 0.0001,
  "prox_mu": 0.01,
  "num_classes": 5,
  "device": "cuda",
  "federated_condition": "FedProx (mu=0.01)"
}